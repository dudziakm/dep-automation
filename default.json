{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base for all dudziakm repos. Phase 2: pull requests only, automerge disabled.",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],

  "dependencyDashboard": true,
  "dependencyDashboardReportAbandonment": true,
  "abandonmentThreshold": "18 months",

  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",

  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,

  "automerge": false,
  "platformAutomerge": false,
  "ignoreTests": false,
  "internalChecksAsSuccess": false,

  "separateMultipleMajor": true,

  "osvVulnerabilityAlerts": true,

  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "automerge": false,
    "labels": ["security"]
  },

  "packageRules": [
    {
      "description": "Every major requires manual approval from the dashboard.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "GitHub Actions as a group; pinning to a SHA comes from config:recommended.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
